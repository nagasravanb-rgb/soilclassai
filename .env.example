# Required for AI image observations
GEMINI_API_KEY=replace_with_your_server_side_gemini_key

# Optional: HTTPS endpoint for a dedicated soil image classifier.
# It must accept raw image bytes with Content-Type set to image/jpeg, image/png, or image/webp.
SOIL_CLASSIFIER_ENDPOINT=
SOIL_CLASSIFIER_TOKEN=
SOIL_CLASSIFIER_MODEL=
